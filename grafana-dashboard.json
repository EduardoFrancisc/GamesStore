{
  "__inputs": [
    {
      "name": "DS_ELASTICSEARCH_LOGS",
      "label": "Elasticsearch (Logs)",
      "description": "Selecione a fonte de dados configurada para gamesstore-logs-*",
      "type": "datasource",
      "pluginId": "elasticsearch",
      "pluginName": "Elasticsearch"
    },
    {
      "name": "DS_ELASTICSEARCH_TRACES",
      "label": "Elasticsearch (Traces)",
      "description": "Selecione a fonte de dados configurada para gamesstore-traces",
      "type": "datasource",
      "pluginId": "elasticsearch",
      "pluginName": "Elasticsearch"
    }
  ],
  "title": "GamesStore - Observability (Logs & Traces)",
  "uid": "gamesstore-obs-dashboard",
  "tags": ["gamesstore", "observability", "elasticsearch"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "panels": [
    {
      "type": "logs",
      "title": "Logs da Aplicação (Filtrado por Trace/Span)",
      "datasource": "${DS_ELASTICSEARCH_LOGS}",
      "gridPos": { "h": 15, "w": 12, "x": 0, "y": 0 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "query": "traceId:\"$traceId\" OR spanId:\"$spanId\"",
          "metrics": [{"type": "logs"}]
        }
      ]
    },
    {
      "type": "table",
      "title": "Traces & Spans (Otel Collector)",
      "datasource": "${DS_ELASTICSEARCH_TRACES}",
      "gridPos": { "h": 15, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "query": "traceId:\"$traceId\" OR spanId:\"$spanId\"",
          "metrics": [{"type": "raw_document"}]
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "traceId",
        "label": "Buscar por Trace ID",
        "query": "*",
        "current": { "selected": false, "text": "*", "value": "*" }
      },
      {
        "type": "textbox",
        "name": "spanId",
        "label": "Buscar por Span ID",
        "query": "*",
        "current": { "selected": false, "text": "*", "value": "*" }
      }
    ]
  }
}
